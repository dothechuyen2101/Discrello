# --- Server ---
# Public hostname (e.g. a DuckDNS subdomain). The host's nginx serves it and certbot issues its
# certificate: see deploy/setup-nginx.sh. Not used by the app itself.
DOMAIN=discrello.duckdns.org
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public HTTPS URL that Trello can reach (tunnel URL in dev, https://$DOMAIN in prod)
PUBLIC_BASE_URL=https://discrello.duckdns.org
LOG_LEVEL=info
# Number of reverse proxies in front of the app (nginx or a tunnel = 1). Do not raise it:
# trusting more hops lets clients fake their IP and bypass the login/webhook rate limits.
TRUST_PROXY_HOPS=1

# --- Docker on the VPS ---
# Host port the container is published on, bound to 127.0.0.1 only (nginx proxies to it).
# Pick a port nothing else on the VPS uses: `ss -ltn | grep 3100`.
DISCRELLO_PORT=3100

# --- DuckDNS (deploy/duckdns-update.sh points the subdomain at the VPS) ---
# Subdomain without .duckdns.org, created on https://www.duckdns.org; token shown on the same page.
DUCKDNS_SUBDOMAIN=discrello
DUCKDNS_TOKEN=

# --- Database (Supabase Postgres, Session pooler URI, port 5432) ---
# Use the "Session pooler" string (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
# Password without the [ ] of the template; URL-encode special characters (@ -> %40).
# For local experiments without Supabase you can use PGlite: pglite://./.pglite  (dev only)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Trello (https://trello.com/power-ups/admin -> API key tab) ---
TRELLO_API_KEY=
TRELLO_API_TOKEN=
# The "Secret" shown next to the API key; used to verify webhook signatures
TRELLO_API_SECRET=

# --- Discord (https://discord.com/developers/applications -> Bot) ---
# Enable "Server Members Intent" under Privileged Gateway Intents
DISCORD_BOT_TOKEN=

# --- Admin UI ---
# At least 12 characters
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# --- Local demo without real Trello/Discord (dev only) ---
# Set to 1 to run the server against in-memory fakes seeded with a sample server, board and lists.
# Lets you click through the UI end to end; nothing is sent to Discord or Trello.
DISCRELLO_FAKE_INTEGRATIONS=0
