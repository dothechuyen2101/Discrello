{
  "name": "@discrello/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed:sports": "tsx --env-file-if-exists=../../.env src/scripts/seed-sports.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@discrello/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.4.0",
    "@fastify/static": "^10.1.4",
    "discord-api-types": "^0.38.55",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
